{
  "expo": {
    "name": "Studious",
    "slug": "studious",
    "owner": "hvzetrp",
    "version": "0.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F3EBDD",
    "ios": {
      "bundleIdentifier": "com.mobiledev.studious.preview",
      "supportsTablet": true
    },
    "android": {
      "package": "com.mobiledev.studious.preview",
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground-safe.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome-safe.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F3EBDD",
          "image": "./assets/splash/studious-splash-light.png",
          "dark": {
            "backgroundColor": "#1E1B18",
            "image": "./assets/splash/studious-splash-dark.png"
          },
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "ed284cd4-2b99-4934-9747-c7068df950a7"
      }
    }
  }
}
